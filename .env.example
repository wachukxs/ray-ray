# Copy to .env (gitignored) and fill in. Values already set in your shell take precedence.

# Claude brain (--mode claude). Without any key the copilot runs the offline brain.
ANTHROPIC_API_KEY=

# LangChain brain (--mode langchain): pick a provider:model and set that provider's key.
# Requires: pip install -e ".[langchain]"
# FLEET_COPILOT_MODE=langchain
# FLEET_COPILOT_LC_MODEL=openai:<model-name>        # or google_genai:<model-name>, anthropic:<model-name>
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# FLEET_COPILOT_LC_TEMPERATURE=0                   # optional; some current models reject temperature

# Optional overrides
# FLEET_COPILOT_MODE=claude          # offline | claude | langchain (default: claude if ANTHROPIC_API_KEY is set, else offline)
# FLEET_COPILOT_MODEL=claude-opus-5-5
# FLEET_COPILOT_EFFORT=medium        # low | medium | high | xhigh | max
# FLEET_DATA_PATH=data/raw/device-telemetry-dataset.ndjson
# FLEET_STATE_DIR=state
